# LipaWiFi — copy to .env and fill in. Never commit .env.

NODE_ENV=development
APP_NAME=LipaWiFi
APP_URL=http://127.0.0.1:43127
PORT=43127

# PostgreSQL (app + FreeRADIUS SQL)
DATABASE_URL=postgresql://lipawifi:change-me@127.0.0.1:5432/lipawifi?schema=public

# Redis (rate limits + scheduler locks)
REDIS_URL=redis://127.0.0.1:6379

# Admin session signing (random 32+ chars)
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Worker / internal API
INTERNAL_API_TOKEN=replace-with-internal-token

# M-Pesa: mock | daraja
MPESA_PROVIDER=mock
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://127.0.0.1:43127/api/v1/webhooks/mpesa/stk
MPESA_C2B_CONFIRMATION_URL=http://127.0.0.1:43127/api/v1/webhooks/mpesa/c2b/confirmation
MPESA_C2B_VALIDATION_URL=http://127.0.0.1:43127/api/v1/webhooks/mpesa/c2b/validation
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
# Auto-complete STK after a few seconds when MPESA_PROVIDER=mock
MPESA_MOCK_AUTO_PAY=true

# Optional: restrict Daraja webhook source IPs (comma-separated). Empty = allow (use nginx in production).
MPESA_WEBHOOK_CIDRS=

# Logging
LOG_LEVEL=info
