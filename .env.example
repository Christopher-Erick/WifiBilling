# LipaWiFi — copy to .env and fill in. Never commit .env.

# =============================================================================
# Local demo
# =============================================================================
NODE_ENV=development
APP_NAME=LipaWiFi
APP_URL=http://127.0.0.1:43127
PORT=43127

# Host ports published by Compose nginx (do not use 3000, 5173, or 8080).
# Local demo: 43127. Production overlay: 80 and 443.
LIPAWIFI_HTTP_PORT=43127
LIPAWIFI_HTTPS_PORT=43443
APP_HOSTNAME=localhost

# PostgreSQL (app + FreeRADIUS SQL)
# Docker Compose always overrides DATABASE_URL and REDIS_URL to the db/redis
# services, so a host URL in this file will not break Compose.
DATABASE_URL=postgresql://lipawifi:change-me@127.0.0.1:5432/lipawifi?schema=public
POSTGRES_PASSWORD=change-me-postgres-password

# Redis (rate limits + scheduler locks)
REDIS_URL=redis://127.0.0.1:6379

# Admin session signing — generate with: openssl rand -hex 32
# Production refuses weak placeholders.
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Worker / internal API — generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=replace-with-internal-token

# Forwarded-IP trust: none | nginx | cloudflare
# none = ignore X-Forwarded-* (default for `npm run dev`)
# nginx = Compose origin proxy (set automatically in docker-compose.yml)
# cloudflare = trust CF-Connecting-IP; only when origin is not reachable except via Cloudflare
TRUST_PROXY=none
COOKIE_SECURE=auto

# M-Pesa: mock | daraja
# mock = local demo only (STK + Paybill fallback + Complete demo payment).
# Rejected when NODE_ENV=production.
MPESA_PROVIDER=mock
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# STK Push and manual Paybill both use this Equity-linked Safaricom shortcode.
# MPESA_PAYBILL wins; otherwise MPESA_SHORTCODE. Link the Paybill to Equity at Safaricom/Equity.
MPESA_SHORTCODE=174379
MPESA_PAYBILL=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://127.0.0.1:43127/api/v1/webhooks/mpesa/stk
MPESA_C2B_CONFIRMATION_URL=http://127.0.0.1:43127/api/v1/webhooks/mpesa/c2b/confirmation
MPESA_C2B_VALIDATION_URL=http://127.0.0.1:43127/api/v1/webhooks/mpesa/c2b/validation
# STK is the customer path (keep true). Paybill details stay on the portal as a fallback.
MPESA_STK_ENABLED=true
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
# Auto-complete STK after a few seconds when MPESA_PROVIDER=mock (Paybill demo
# still uses the Complete demo payment button).
MPESA_MOCK_AUTO_PAY=false

# Optional: restrict Daraja webhook source IPs (comma-separated). Empty = allow
# (use nginx / Cloudflare in production). Requires TRUST_PROXY=nginx or cloudflare.
MPESA_WEBHOOK_CIDRS=

# Optional Cloudflare Tunnel (docker compose --profile cloudflare)
CLOUDFLARE_TUNNEL_TOKEN=

# Logging
LOG_LEVEL=info

# =============================================================================
# Production checklist (Docker + Cloudflare)
# Copy these over the demo values. Do not leave mock or weak secrets.
# Or use: docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build
# =============================================================================
# NODE_ENV=production
# APP_URL=https://wifi.example.com
# LIPAWIFI_HTTP_PORT=80
# LIPAWIFI_HTTPS_PORT=443
# MPESA_PROVIDER=daraja
# MPESA_ENV=production
# MPESA_PAYBILL=your-live-paybill
# MPESA_SHORTCODE=your-live-paybill
# MPESA_CONSUMER_KEY=from-daraja-portal
# MPESA_CONSUMER_SECRET=from-daraja-portal
# MPESA_PASSKEY=from-daraja-portal
# MPESA_CALLBACK_URL=https://wifi.example.com/api/v1/webhooks/mpesa/stk
# MPESA_C2B_CONFIRMATION_URL=https://wifi.example.com/api/v1/webhooks/mpesa/c2b/confirmation
# MPESA_C2B_VALIDATION_URL=https://wifi.example.com/api/v1/webhooks/mpesa/c2b/validation
# SESSION_SECRET=  # openssl rand -hex 32
# INTERNAL_API_TOKEN=  # openssl rand -hex 32
# POSTGRES_PASSWORD=   # strong password; Compose uses it for db + DATABASE_URL override
# MPESA_STK_ENABLED=true
# MPESA_MOCK_AUTO_PAY=false
# TRUST_PROXY=nginx
