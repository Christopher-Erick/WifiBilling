# Production template. Copy to .env on the server. Never commit .env.

NODE_ENV=production
APP_NAME=LipaWiFi
APP_URL=https://wifi.example.co.ke
PORT=43127
APP_HOSTNAME=wifi.example.co.ke

LIPAWIFI_HTTP_PORT=80
LIPAWIFI_HTTPS_PORT=443

POSTGRES_PASSWORD=generate-a-long-random-password
DATABASE_URL=postgresql://lipawifi:generate-a-long-random-password@127.0.0.1:5432/lipawifi?schema=public

REDIS_URL=redis://127.0.0.1:6379

SESSION_SECRET=generate-at-least-32-random-characters
INTERNAL_API_TOKEN=generate-at-least-16-random-characters

# nginx if Cloudflare orange-cloud forwards to origin nginx (recommended with real_ip).
# cloudflare if the app sees CF-Connecting-IP directly (tunnel) AND origin is not public.
TRUST_PROXY=nginx
COOKIE_SECURE=auto

MPESA_PROVIDER=daraja
MPESA_ENV=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Safaricom Paybill that settles into the Equity Bank account (linked at Safaricom/Equity).
MPESA_SHORTCODE=
MPESA_PAYBILL=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://wifi.example.co.ke/api/v1/webhooks/mpesa/stk
MPESA_C2B_CONFIRMATION_URL=https://wifi.example.co.ke/api/v1/webhooks/mpesa/c2b/confirmation
MPESA_C2B_VALIDATION_URL=https://wifi.example.co.ke/api/v1/webhooks/mpesa/c2b/validation
MPESA_STK_ENABLED=true
MPESA_MOCK_AUTO_PAY=false
MPESA_WEBHOOK_CIDRS=

LOG_LEVEL=info
